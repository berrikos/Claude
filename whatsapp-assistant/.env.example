# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your own WhatsApp number(s), digits only with country code, comma-separated.
# ONLY these numbers can talk to the assistant (it can run commands on your PC,
# so this is a hard security gate — leave nobody else in here).
# Example for an Australian mobile 0412 345 678 -> 61412345678
ALLOWED_NUMBERS=

# Optional ------------------------------------------------------------------

# Directory PC tasks operate in (default: your home directory)
# ASSISTANT_WORK_DIR=/home/you

# Name the assistant uses for itself
# ASSISTANT_NAME=Jarvis

# How many recent messages are kept in the prompt (older ones are recalled
# from memory search instead)
# HISTORY_WINDOW=20

# Safety cap on agent-loop turns per PC task
# MAX_AGENT_TURNS=40
