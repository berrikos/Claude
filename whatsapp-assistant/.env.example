# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your own WhatsApp number(s), digits only with country code, comma-separated.
# ONLY these numbers can talk to the assistant (it can run commands on your PC,
# so this is a hard security gate — leave nobody else in here).
# Example for an Australian mobile 0412 345 678 -> 61412345678
ALLOWED_NUMBERS=

# WhatsApp transport ---------------------------------------------------------
# 'whapi' (recommended if you have a whapi.cloud subscription — webhook-based,
# no QR pairing) or 'baileys' (free, direct WhatsApp Web protocol, QR pairing).
# Auto-selects whapi when WHAPI_TOKEN is set.
# WA_PROVIDER=whapi

# Whapi channel token from your whapi.cloud dashboard
WHAPI_TOKEN=

# Port + path this app listens on for Whapi webhooks
# (point your Whapi channel's webhook at http://<your-address>:8088/webhook)
# WEBHOOK_PORT=8088
# WEBHOOK_PATH=/webhook

# Obsidian brain -------------------------------------------------------------
# Absolute path to your Obsidian vault. When set, the vault becomes the
# long-term memory: facts live in <vault>/Assistant/Facts.md, chats are logged
# as daily notes, and recall searches your entire vault (your own notes too).
# OBSIDIAN_VAULT=/home/you/Documents/MyVault

# Subfolder inside the vault for assistant-managed notes (default: Assistant)
# OBSIDIAN_FOLDER=Assistant

# Optional ------------------------------------------------------------------

# Directory PC tasks operate in (default: your home directory)
# ASSISTANT_WORK_DIR=/home/you

# Name the assistant uses for itself
# ASSISTANT_NAME=Jarvis

# How many recent messages are kept in the prompt (older ones are recalled
# from memory search instead)
# HISTORY_WINDOW=20

# Safety cap on agent-loop turns per PC task
# MAX_AGENT_TURNS=40
